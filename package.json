{
  "name": "hide-and-seek",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-eliminate.mts",
    "data:stations": "node scripts/import-stations.mjs",
    "data:area": "node scripts/build-area.mjs",
    "data:pois": "node scripts/fetch-pois.mjs",
    "data:divisions": "node scripts/fetch-divisions.mjs",
    "data:borders": "node scripts/fetch-borders.mjs",
    "data:questions": "node scripts/build-questions.mjs",
    "data": "npm run data:stations && npm run data:area && npm run data:pois && npm run data:divisions && npm run data:borders && npm run data:questions"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@turf/buffer": "^7.4.0",
    "@turf/convex": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
